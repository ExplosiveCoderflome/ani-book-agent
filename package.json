{
  "name": "ani-novel-agent",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "concurrently -k -n studio,web -c magenta,cyan \"pnpm dev:studio\" \"pnpm dev:web\"",
    "dev:studio": "mastra dev",
    "dev:web": "vite --host 127.0.0.1 --port 5175",
    "build": "mastra build",
    "build:web": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "pnpm test && pnpm typecheck && pnpm build:web && pnpm build"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.13",
    "@assistant-ui/react-markdown": "0.14.6",
    "@hookform/resolvers": "^5.2.2",
    "@mastra/core": "1.57.0",
    "@mastra/duckdb": "1.6.0",
    "@mastra/editor": "0.13.11",
    "@mastra/libsql": "1.19.0",
    "@mastra/memory": "1.26.0",
    "@mastra/observability": "1.16.5",
    "@primno/dpapi": "^2.0.1",
    "@tanstack/react-query": "^5.85.0",
    "@ungap/structured-clone": "1.3.3",
    "gsap": "3.13.0",
    "lucide-react": "^0.539.0",
    "motion": "12.31.1",
    "ogl": "^1.0.11",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.62.0",
    "react-markdown": "10.1.0",
    "react-router-dom": "^7.8.0",
    "remark-gfm": "^4.0.1",
    "thinking-orbs": "0.3.1",
    "yaml": "^2.8.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.2.1",
    "mastra": "1.23.0",
    "tsx": "4.23.11",
    "typescript": "^5.9.2",
    "vite": "^8.0.0"
  }
}
